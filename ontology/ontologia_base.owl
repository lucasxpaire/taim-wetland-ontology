<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.exemplo.org/taim"
         xmlns="http://www.exemplo.org/taim#">

<owl:Ontology rdf:about="http://www.exemplo.org/taim"/>

<owl:ObjectProperty rdf:about="#envolveAnimal">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#Animal"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ocorreEm">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#TrechoRodovia"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ocorreSob">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#CondicaoClimatica"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#proximoA">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="#Habitat"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#viveEm">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="#Habitat"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atravessa">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="#Rodovia"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pertenceARodovia">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="#Rodovia"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#presaDe">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="#Animal"/>
  <owl:inverseOf rdf:resource="#predadorDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#predadorDe">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="#Animal"/>
  <owl:inverseOf rdf:resource="#presaDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ocorreuAntesDe">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="#EventoAtropelamento"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#dataHora">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#kmRodovia">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomeCientifico">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomeComum">
  <rdfs:domain rdf:resource="#Animal"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#velocidadeVia">
  <rdfs:domain rdf:resource="#Rodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#temperaturaCelsius">
  <rdfs:domain rdf:resource="#CondicaoClimatica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nivelAguaMetro">
  <rdfs:domain rdf:resource="#Habitat"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#severidadeAcidente">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#latitude">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#longitude">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#estacaoAno">
  <rdfs:domain rdf:resource="#EventoAtropelamento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fluxoVeiculosHora">
  <rdfs:domain rdf:resource="#TrechoRodovia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#visibilidadeMetros">
  <rdfs:domain rdf:resource="#CondicaoClimatica"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Animal">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Mamifero">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Ave">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Reptil">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Anfibio">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Capivara">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#Tuco-tuco">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#Ratão-do-banhado">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#Graxaim">
  <rdfs:subClassOf rdf:resource="#Mamifero"/>
</owl:Class>

<owl:Class rdf:about="#Cisne-de-pescoço-preto">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Flamingo">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Colhereiro">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Maçarico">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Tachã">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Garça-moura">
  <rdfs:subClassOf rdf:resource="#Ave"/>
</owl:Class>

<owl:Class rdf:about="#Jacaré-de-papo-amarelo">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Tartaruga">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Cobra">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Sapo">
  <rdfs:subClassOf rdf:resource="#Anfibio"/>
</owl:Class>

<owl:Class rdf:about="#Rã">
  <rdfs:subClassOf rdf:resource="#Anfibio"/>
</owl:Class>

<owl:Class rdf:about="#Habitat">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Banhado">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#CorpoDagua">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#Vegetacao">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#Rodovia">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#TrechoRodovia">
  <rdfs:subClassOf rdf:resource="#Rodovia"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#pertenceARodovia"/>
      <owl:onClass rdf:resource="#Rodovia"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#kmRodovia"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CondicaoAmbiental">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CondicaoClimatica">
  <rdfs:subClassOf rdf:resource="#CondicaoAmbiental"/>
</owl:Class>

<owl:Class rdf:about="#Evento">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EventoAtropelamento">
  <rdfs:subClassOf rdf:resource="#Evento"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#envolveAnimal"/>
      <owl:onClass rdf:resource="#Animal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#ocorreEm"/>
      <owl:onClass rdf:resource="#TrechoRodovia"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#ocorreSob"/>
      <owl:onClass rdf:resource="#CondicaoClimatica"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#severidadeAcidente"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#dataHora"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>


</rdf:RDF>
